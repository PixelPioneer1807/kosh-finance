# ─────────────────────────────────────────────────────────────────────────────
# Kosh — environment variables. Copy to .env.local for local development.
# On Vercel, set these in Project → Settings → Environment Variables.
# Never commit real values.
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL connection string (required).
#   Local (docker compose):  postgres://kosh:kosh@127.0.0.1:55432/kosh
#   Neon (production):       use the *pooled* connection string (host contains "-pooler")
DATABASE_URL=
# Optional direct (non-pooled) URL used only for running migrations (Neon: the non-pooler host).
DATABASE_URL_UNPOOLED=
# Max connections per server instance (keep small on serverless).
DATABASE_POOL_MAX=5

# Only for `npm test` — a database the suite may create throwaway databases next to.
TEST_DATABASE_URL=postgres://kosh:kosh@127.0.0.1:55432/kosh_test

# Required. Random secret (32+ bytes) used to key invite-code hashes. Generate: openssl rand -base64 32
AUTH_SECRET=

# Public URL of the app (used in password-reset links and emails).
APP_URL=http://localhost:3210

# ── AI (Groq, OpenAI-compatible API) ─────────────────────────────────────────
# Server-side only. Get a key at https://console.groq.com/keys . Leave empty to disable AI.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=qwen/qwen3.8-27b
# Per-user daily cap on AI requests (abuse/cost protection).
AI_DAILY_REQUEST_LIMIT=300

# ── Scheduled jobs ───────────────────────────────────────────────────────────
# Bearer token required by /api/cron/tick (Vercel Cron sends it automatically when set as CRON_SECRET).
CRON_SECRET=

# ── Web Push (browser/phone notifications) ───────────────────────────────────
# Generate a pair with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
# Set to 1 to register the service worker in development (always on in production).
NEXT_PUBLIC_ENABLE_SW=

# ── Email (optional; password-reset emails) ──────────────────────────────────
# Without it, admins can generate reset links from Admin → Users.
RESEND_API_KEY=
EMAIL_FROM="Kosh <no-reply@yourdomain.com>"

# ── Branding (optional) ──────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=Kosh
