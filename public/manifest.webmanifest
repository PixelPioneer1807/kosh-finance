{
  "id": "/",
  "name": "Kosh",
  "short_name": "Kosh",
  "description": "Know exactly where your money goes.",
  "start_url": "/dashboard?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#fafaf9",
  "theme_color": "#fafaf9",
  "categories": ["finance", "productivity"],
  "lang": "en",
  "dir": "ltr",
  "prefer_related_applications": false,
  "icons": [
    { "src": "/icons/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" },
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    {
      "name": "Add expense",
      "short_name": "Add expense",
      "description": "Log a new expense",
      "url": "/dashboard?add=expense",
      "icons": [{ "src": "/icons/shortcut-add.png", "sizes": "96x96", "type": "image/png" }]
    },
    {
      "name": "Transactions",
      "short_name": "Transactions",
      "description": "Search and review your transactions",
      "url": "/transactions",
      "icons": [{ "src": "/icons/shortcut-transactions.png", "sizes": "96x96", "type": "image/png" }]
    },
    {
      "name": "Budgets",
      "short_name": "Budgets",
      "description": "Check your budgets",
      "url": "/budgets",
      "icons": [{ "src": "/icons/shortcut-budgets.png", "sizes": "96x96", "type": "image/png" }]
    }
  ]
}
